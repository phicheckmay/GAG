-- ========================================================================
-- GOLD BOX - mo THEM box classic bang VANG sau khi HOAN THANH nhiem vu
-- (goi trong doChangeAccAndKick, ngay truoc khi roi acc - KHONG chay luc farm)
-- ========================================================================
-- Vang = Coins (currency dump). Boxes = list id classic (GunBox1/KnifeBox1...).
-- LUU Y: arg giua cua OpenCrate KHONG phai field BoxType (Summer2026Box co
-- BoxType="Weapons" nhung mo bang "MysteryBox"). Nen thu GB.BoxType truoc, sai
-- thi TU DO cac candidate con lai (cai nao lam VANG GIAM thi khoa cho box do).
-- Arg sai -> server tu choi -> vang khong doi -> khong ton gi.
local GB = (type(Config.GoldBox) == "table") and Config.GoldBox or {}
local GB_ENABLED  = GB.Enabled == true
local GB_CURRENCY = GB.Currency or "Coins"
local GB_PRICE    = GB.Price or 1000
local GB_KEEP     = GB.KeepGold or 0
local GB_MAX      = GB.MaxPerKick or 10
local GB_TYPE_CANDIDATES = (type(GB.TypeCandidates) == "table" and GB.TypeCandidates)
    or { GB.BoxType or "MysteryBox", "Weapons", "GunBox", "Classic" }

-- Danh sach hop: uu tien GB.Boxes (mang), fallback GB.BoxId (1 hop kieu cu)
local GB_BOXES = {}
if type(GB.Boxes) == "table" then
    for _, id in ipairs(GB.Boxes) do
        if type(id) == "string" and id ~= "" then table.insert(GB_BOXES, id) end
    end
elseif type(GB.BoxId) == "string" and GB.BoxId ~= "" then
    table.insert(GB_BOXES, GB.BoxId)
end

local gbTypeFor = {}   -- moi box tu nho arg giua da calibrate

-- Doc so vang: uu tien key cap 1 cua ProfileData, fallback Materials.Owned
local function getGold()
    local pd = getProfileData()
    if not pd then return nil end
    local v = pd[GB_CURRENCY]
    if type(v) == "number" then return v end
    if pd.Materials and pd.Materials.Owned then
        v = pd.Materials.Owned[GB_CURRENCY]
        if type(v) == "number" then return v end
        return tonumber(v)
    end
    return nil
end

-- Mo 1 hop. Chua biet arg giua -> tu do (thu GB.BoxType truoc, chi ton vang khi DUNG).
local function openGoldBoxOnce(boxId)
    local locked = gbTypeFor[boxId]
    if locked then
        local ok, r = pcall(function()
            return OpenCrateRemote:InvokeServer(boxId, locked, GB_CURRENCY)
        end)
        if ok and r ~= nil and r ~= false then return r end
        return nil
    end
    for _, cand in ipairs(GB_TYPE_CANDIDATES) do
        local before = getGold() or 0
        local ok, r = pcall(function()
            return OpenCrateRemote:InvokeServer(boxId, cand, GB_CURRENCY)
        end)
        task.wait(4)   -- doi server tru vang + replica cap nhat (FPS cap thap nen de du)
        if ok and (getGold() or 0) < before then
            gbTypeFor[boxId] = cand
            print("[GoldBox] " .. boxId .. " arg giua = '" .. cand .. "'")
            return r or true
        end
    end
    return nil
end

-- Mo lien tuc (xoay vong deu list) den khi het vang (chua KeepGold),
-- cham GB_MAX, hoac tat ca hop deu fail 1 vong
local function drainGoldBoxes()
    if not GB_ENABLED then return 0 end
    if #GB_BOXES == 0 or GB_CURRENCY == "" then
        print("[GoldBox] Thieu Boxes/Currency trong config -> bo qua.")
        return 0
    end
    local opened, idx, failStreak = 0, 1, 0
    while opened < GB_MAX and failStreak < #GB_BOXES do
        local gold = getGold()
        if gold == nil then
            print("[GoldBox] Khong doc duoc vang key '" .. GB_CURRENCY .. "' -> bo qua")
            break
        end
        if gold < GB_PRICE + GB_KEEP then break end
        local boxId = GB_BOXES[idx]
        idx = (idx % #GB_BOXES) + 1
        local result = openGoldBoxOnce(boxId)
        if result ~= nil and result ~= false then
            failStreak = 0
            if type(result) == "string" then
                sendItemWebhook(Player.Name, result)
            elseif type(result) == "table" then
                for _, itemId in pairs(result) do
                    if type(itemId) == "string" then sendItemWebhook(Player.Name, itemId) end
                end
            end
            opened = opened + 1
            StatusLabel.Text = "⚡ Status: Mở " .. boxId .. " (" .. opened .. ")..."
            StatusLabel.TextColor3 = Color3.fromRGB(255, 220, 0)
            print("[GoldBox] " .. boxId .. " OK -> tong " .. opened .. " hop, con " .. tostring(getGold()) .. " vang")
            task.wait(OPEN_CRATE_DELAY)
        else
            failStreak = failStreak + 1
            print("[GoldBox] " .. boxId .. " mo that bai (" .. failStreak .. "/" .. #GB_BOXES .. ")")
            task.wait(0.5)
        end
    end
    -- LUON in tong ket de log tu khai: vang luc kick + nguong + so hop mo duoc.
    -- vang < nguong & 0 hop = chua du tien (khong phai loi); vang >= nguong & 0 hop
    -- = loi ky thuat (xem dong "mo that bai"/"Khong doc duoc vang" ngay tren)
    print(string.format("[GoldBox] Pre-kick: vang %s | nguong %d+%d | mo %d hop",
        tostring(getGold()), GB_PRICE, GB_KEEP, opened))
    return opened
end

if GB_ENABLED then
    print("[GoldBox] Che do: mo them SAU KHI hoan thanh, truoc khi kick | "
        .. (#GB_BOXES > 0 and table.concat(GB_BOXES, ", ") or "CHUA CO Boxes")
        .. " | gia " .. GB_PRICE .. " " .. (GB_CURRENCY ~= "" and GB_CURRENCY or "?")
        .. " | giu lai " .. GB_KEEP .. " | max " .. GB_MAX .. "/lan")
end

