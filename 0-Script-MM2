local function formatNumber(num)
    local s = tostring(num)
    local k
    repeat s, k = string.gsub(s, "^(-?%d+)(%d%d%d)", "%1,%2") until k == 0
    return s
end

local function displayNum(n)
    if type(n) ~= "number" then return "-" end
    return formatNumber(n)
end

