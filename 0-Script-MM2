-- 2. Graphics optimization (1 lan)
local function optimizeGraphics()
    local Lighting = game:GetService("Lighting")
    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
    pcall(function() RunService:Set3dRenderingEnabled(false) end)
    pcall(function() Lighting.GlobalShadows = false end)

    for _, effect in ipairs(Lighting:GetChildren()) do
        if effect:IsA("BloomEffect") or effect:IsA("SunRaysEffect")
        or effect:IsA("DepthOfFieldEffect") or effect:IsA("BlurEffect")
        or effect:IsA("ColorCorrectionEffect") then
            effect.Enabled = false
        elseif effect:IsA("Atmosphere") then
            effect.Density = 0
            effect.Haze    = 0
            effect.Color   = Color3.new(1,1,1)
            effect.Decay   = Color3.new(1,1,1)
        end
    end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if not isProtected(obj) then
            if isEffect(obj) then
                obj.Enabled = false
            elseif obj:IsA("Sound") then
                pcall(function() obj.Volume = 0 end)
            end
        end
    end
end

-- 3. Live effect/sound killer (event-driven, khong loop)
local function startLiveKiller()
    trackConn(workspace.DescendantAdded:Connect(function(obj)
        if isProtected(obj) then return end
        if isEffect(obj) then
            obj.Enabled = false
        elseif obj:IsA("Sound") then
            pcall(function() obj.Volume = 0 end)
        end
    end))
end

-- 4. Collision disabler (event-driven, khong loop Stepped)
local function hookCharacterCollision(char)
    if not char then return end
    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("BasePart") and v.CanCollide then
            v.CanCollide = false
        end
    end
    trackConn(char.DescendantAdded:Connect(function(v)
        if v:IsA("BasePart") and v.CanCollide then
            v.CanCollide = false
        end
    end))
end

local function startCollisionDisabler()
    if Player.Character then hookCharacterCollision(Player.Character) end
    trackConn(Player.CharacterAdded:Connect(hookCharacterCollision))
end

