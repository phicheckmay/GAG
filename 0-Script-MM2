local function returncoincontainer()
    for _, v in ipairs(workspace:GetChildren()) do
        if v:FindFirstChild("CoinContainer") and v:IsA("Model") then
            return v:FindFirstChild("CoinContainer")
        end
    end
    return nil
end

-- FIX: lay coin gan nhat thay vi random shuffle
local function getNearestCoin(container)
    if not BadanPart then return nil end
    local nearest, minDist = nil, math.huge
    for _, coin in ipairs(container:GetChildren()) do
        if coin:FindFirstChild("TouchInterest") then
            local pos = coin:IsA("BasePart") and coin.Position
                     or (coin:IsA("Model") and coin.PrimaryPart and coin.PrimaryPart.Position)
            if pos then
                local dist = (BadanPart.Position - pos).Magnitude
                if dist < minDist then
                    nearest = coin
                    minDist  = dist
                end
            end
        end
    end
    return nearest
end

local function getCoinCFrame(coin)
    if coin:IsA("BasePart") then return coin.CFrame end
    if coin:IsA("Model") and coin.PrimaryPart then return coin.PrimaryPart.CFrame end
    return nil
end

