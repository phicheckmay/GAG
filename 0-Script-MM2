    lbl.Position = pos
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = color
    lbl.Font = bold and Enum.Font.GothamBold or Enum.Font.GothamSemibold
    lbl.TextScaled = true
    createNeon(lbl, color)
    return lbl
end

