local function teleportToPlatform()
    local plat = workspace:FindFirstChild("Papan") or createPlatform()
    if BadanPart then
        local yOff = plat.Size.Y/2 + BadanPart.Size.Y/2 + 4
        BadanPart.CFrame = plat.CFrame + Vector3.new(0, yOff, 0)
    end
end

