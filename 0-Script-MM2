-- Daily Quest = ProfileData["Summer2026"].Quests["DailyCoins"].Progress
-- Milestones: 60 / 120 / 240 / 480 (tu UI game)
local DAILY_MILESTONES = {60, 120, 240, 480}

local function getSummerDailyQuestsProgress()
    local completed, total, rawProgress, maxChallenge = 0, #DAILY_MILESTONES, 0, DAILY_MILESTONES[#DAILY_MILESTONES]
    pcall(function()
        local pd = getProfileData()
        if not pd then return end
        local title = getSummerEventTitle()
        local eventData = pd[title]
        if not eventData or not eventData.Quests then return end
        local dailyData = eventData.Quests["DailyCoins"]
        if not dailyData or type(dailyData) ~= "table" then return end
        rawProgress = tonumber(dailyData.Progress) or 0
        completed = 0
        for _, milestone in ipairs(DAILY_MILESTONES) do
            if rawProgress >= milestone then
                completed = completed + 1
            end
        end
    end)
    return completed, total, rawProgress, maxChallenge
end

