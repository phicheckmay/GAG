        task.wait(60)
        local GC = getconnections or get_signal_cons
        if GC then
            for _, v in pairs(GC(Player.Idled)) do
                if v["Disable"] then v["Disable"](v)
                elseif v["Disconnect"] then v["Disconnect"](v) end
