-- FIX: neu re-inject luc round dang chay va acc dang song -> RoundStart da fire
-- tu truoc nen AutofarmStarted ket false mai. Bat farm + dong bo trang thai round.
-- (Vao server moi qua hop thi dang o lobby, PlayerData chua co ten -> khong dinh nham.)
pcall(function()
    local CRC = require(RS.Modules.CurrentRoundClient)
    local pd  = CRC.PlayerData[Player.Name]
    if pd and pd.Dead ~= true then
        AutofarmStarted    = true
        isRoundActive      = true
        lastRoundStartTime = tick()
    end
end)

while true do
    pcall(function()
        local isAlive = false
        pcall(function()
            local CRC = require(RS.Modules.CurrentRoundClient)
            local pd  = CRC.PlayerData[Player.Name]
            isAlive   = pd ~= nil and pd.Dead ~= true
        end)

        if AUTO_FARM and AutofarmStarted and not RoundEnded and not BagFull and isAlive then
            local char = Player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                BadanPart = char.HumanoidRootPart

                local coinContainer = getCoinContainer()
                if coinContainer then
                    -- V2.4: nhat lien COINS_PER_TRIP coin moi chuyen; coin ke tiep
                    -- do tu VI TRI HIEN TAI (dang dung o coin vua nhat) -> chain chuan
                    local attempted = false
                    for _ = 1, COINS_PER_TRIP do
                        if BagFull then break end
                        local coin = getNearestCoin(coinContainer)
                        if not coin then break end
                        local cf = getCoinCFrame(coin)
                        if not cf then break end
                        attempted = true

                        BadanPart.CFrame = cf
                        local collectStart = tick()
                        while coin.Parent == coinContainer
                        and coin:FindFirstChild("TouchInterest")
                        and (tick() - collectStart < COIN_TIMEOUT) do
                            pcall(function() BadanPart.CFrame = cf end)
                            -- Touched (1) truoc, TouchEnded (0) sau
                            pcall(function()
                                firetouchinterest(BadanPart, coin, 1)
                                task.wait(0.1)
                                firetouchinterest(BadanPart, coin, 0)
                            end)
                            task.wait(0.1)
                        end

                        if coin.Parent == coinContainer and coin:FindFirstChild("TouchInterest") then
                            -- Het timeout ma coin van con -> ket, bo qua 8s
                            skipUntil[coin] = tick() + 8
                        end
                    end

                    if attempted then
                        teleportToPlatform()
                        task.wait(COIN_DELAY)
                    end
                end
            end
        end
    end)
    task.wait(0.2)
end
