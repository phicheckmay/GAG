-- Dieu kien kick = Daily Quest DU + TONG box da mo DU target
-- Box target la CONG DON theo moc Weekly Quest (khong reset moi ngay):
--   week <= 6        -> tong 2 box  (ngay 1: 0/2, mo them 2)
--   6 < week <= 12   -> tong 3 box  (ngay 2: 2/3, mo them 1)
--   week > 12        -> tong 5 box  (ngay 3: 3/5, mo them 2)
local DAILY_KICK_TARGET = (Config.AutoKick and Config.AutoKick.DailyTarget) or 960
-- Sau khi daily du 960: neu X phut khong mo them duoc box nao -> kick.
-- Dong ho nay bat dau tu luc daily xong, va reset moi lan mo duoc 1 box.
-- Shell = 0 tu dong roi vao day (khong mo duoc box -> het 10p -> kick).
local STALL_MINUTES     = (Config.AutoKick and Config.AutoKick.StallMinutes) or 10

local DEFAULT_WEEKLY_BOX_TIERS = {
    { max = 6,  box = 2 },
    { max = 12, box = 3 },
    { max = 18, box = 5 },
}

-- FIX (CRITICAL): script chi chap nhan dang ARRAY {{max=,box=},...}.
-- Neu config dua sai dang (vd map {[0]=2,[6]=1,...}) thi ipairs lap 0 lan,
-- #t = 0, last = t[0] = number -> "attempt to index number" -> CA tick AutoKick
-- chet trong pcall (khong kick, khong set DAILY_DONE). Validate + fallback default.
local function normalizeWeeklyTiers(raw)
    if type(raw) == "table" then
        local n, ok = 0, true
        for _, tier in ipairs(raw) do
            n = n + 1
            if type(tier) ~= "table" or type(tier.max) ~= "number" or type(tier.box) ~= "number" then
                ok = false
                break
            end
        end
        if ok and n > 0 then return raw end
    end
    print("[AutoKick] WeeklyBoxTiers sai dinh dang -> dung default (can array {max=,box=})")
    return DEFAULT_WEEKLY_BOX_TIERS
end

local WEEKLY_BOX_TIERS = normalizeWeeklyTiers(Config.AutoKick and Config.AutoKick.WeeklyBoxTiers)

local function getBoxTargetByWeekly(weekly)
    for _, tier in ipairs(WEEKLY_BOX_TIERS) do
        if weekly <= tier.max then return tier.box, tier.max end
    end
    local last = WEEKLY_BOX_TIERS[#WEEKLY_BOX_TIERS] or DEFAULT_WEEKLY_BOX_TIERS[#DEFAULT_WEEKLY_BOX_TIERS]
    return last.box, last.max
end

local function doChangeAccAndKick(reason)
