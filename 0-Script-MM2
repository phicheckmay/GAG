-- Connection manager
local Conns = {}
local function trackConn(conn) table.insert(Conns, conn) return conn end
local function cleanupConns()
    for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
    table.clear(Conns)
end
pcall(function()
    if getgenv then getgenv().__perfCleanup = cleanupConns end
end)

local function isProtected(obj)
    local prot = workspace:FindFirstChild("__THINGS")
    return prot ~= nil and obj:IsDescendantOf(prot)
end

local function isEffect(obj)
    return obj:IsA("ParticleEmitter") or obj:IsA("Trail")
        or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles")
end

