            task.wait(2)
            local ok, result = pcall(function()
                API = HttpService:JSONDecode(game:HttpGet(
                    "https://games.roblox.com/v1/games/" .. game.PlaceId ..
                    "/servers/Public?sortOrder=Asc&limit=100" ..
                    (ServerPages and "&cursor=" .. ServerPages or "")
                ))
            end)
            if not ok then task.wait(10) return false end
            for _, v in next, API["data"] do
                if v["id"] ~= game.JobId
                and v["playing"] ~= v["maxPlayers"]
                and v["playing"] >= MinPlayers
                and v["playing"] <= MaxPlayers then
                    if #JobIDs < Amount + 1 then
                        table.insert(JobIDs, v["id"])
                    end
                end
            end
            ServerPages = API.nextPageCursor
        until not ServerPages or #JobIDs >= Amount + 1
        if Logs then print("✅ Found " .. (#JobIDs-1) .. " servers in " .. math.round(tick()-_s) .. "s") end
        return true
    end

    if not isfile("ServerHopper//" .. game.PlaceId .. "//low_players-jobids.json") then
        FetchJobIDs()
        CreateFiles("low_players-jobids", HttpService:JSONEncode(JobIDs))
    end

    JobIDs = HttpService:JSONDecode(readfile("ServerHopper//" .. game.PlaceId .. "//low_players-jobids.json"))

    if JobIDs[1] ~= os.date("*t").hour then
        FetchJobIDs()
        writefile("ServerHopper//" .. game.PlaceId .. "//low_players-jobids.json", HttpService:JSONEncode(JobIDs))
    end

    -- FIX: JobIDs[1] la MARKER GIO (cache staleness), khong phai JobId.
    -- Phai random tu index 2. Neu cache rong (scrape 0 server / HttpGet fail)
    -- thi ghi marker -1 de vong check 30s sau tu refetch, tranh fail loop 100%.
    local function pickJobId()
        if #JobIDs < 2 then return nil end
        return JobIDs[math.random(2, #JobIDs)]
    end

    local SelectedJobID = pickJobId()
    if not SelectedJobID then
        print("[Hop] Cache rong -> ep refetch lan sau")
        pcall(function()
            writefile("ServerHopper//" .. game.PlaceId .. "//low_players-jobids.json",
                HttpService:JSONEncode({ -1 }))
        end)
        return
    end
    if Logs then print("🎯 Hopping to: " .. SelectedJobID) end
    TeleportService:TeleportToPlaceInstance(game.PlaceId, SelectedJobID)
    Player.OnTeleport:Connect(function(Status)
        if Status == Enum.TeleportState.Failed then
            local retry = pickJobId()
            if retry then TeleportService:TeleportToPlaceInstance(game.PlaceId, retry) end
        end
    end)
end

local function checkRoundTimeout()
    if not HOP_ENABLED then return end
    if DAILY_DONE then return end   -- daily xong roi, de AutoKick lo
    if tick() - lastRoundStartTime >= ROUND_TIMEOUT and not isRoundActive then
        print("🚨 No round for " .. math.floor(ROUND_TIMEOUT/60) .. " min, hopping...")
        StatusLabel.Text = "⚡ Status: Server hop (het round)..."
        StatusLabel.TextColor3 = Color3.fromRGB(255,100,50)
        hopToLowPlayers(true, HOP_SCRAPE_AMOUNT, HOP_MIN_PLAYERS, HOP_MAX_PLAYERS)
    end
end

-- Moc do coin de tinh toc do farm.
-- Dung DAILY progress chu KHONG dung so shell dang cam:
-- shell bi tru moi lan mo box nen se am, con daily progress chi tang.
local coinWindowStart = tick()
local coinWindowBase  = nil

local function checkCoinRate()
    if not HOP_ENABLED then return end
    if HOP_COIN_THRESHOLD <= 0 then return end   -- 0 = tat
    if DAILY_DONE then return end                -- farm xong roi, khong hop nua

    local _, _, dqNow = getSummerDailyQuestsProgress()
    dqNow = dqNow or 0

    if coinWindowBase == nil then
        coinWindowBase  = dqNow
        coinWindowStart = tick()
        return
    end

    local elapsed = tick() - coinWindowStart
    if elapsed < HOP_COIN_SECONDS then return end

    local gained = dqNow - coinWindowBase
    -- Daily vua reset giua cua so (dqNow tut ve 0) -> gained am -> mo cua so moi, khong hop oan
    if gained < 0 then
        coinWindowBase  = dqNow
        coinWindowStart = tick()
        return
    end
    if gained < HOP_COIN_THRESHOLD then
        print(string.format("🚨 Chi kiem %d coin trong %d phut (can %d) -> hop server",
            gained, math.floor(elapsed/60), HOP_COIN_THRESHOLD))
        StatusLabel.Text = "⚡ Status: Server hop (farm cham)..."
        StatusLabel.TextColor3 = Color3.fromRGB(255,100,50)
        hopToLowPlayers(true, HOP_SCRAPE_AMOUNT, HOP_MIN_PLAYERS, HOP_MAX_PLAYERS)
    else
        print(string.format("[CoinRate] OK: +%d coin / %d phut", gained, math.floor(elapsed/60)))
    end

    -- Mo cua so do moi
    coinWindowBase  = dqNow
    coinWindowStart = tick()
end

task.spawn(function()
    task.wait(30)
    while true do
        checkRoundTimeout()
        checkCoinRate()
        task.wait(30)
    end
end)

