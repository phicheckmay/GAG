local function CreateFiles(FileName, File)
    pcall(function()
        makefolder("ServerHopper")
        makefolder("ServerHopper//" .. game.PlaceId)
        writefile("ServerHopper//" .. game.PlaceId .. "//" .. FileName .. ".json", File)
    end)
end

local function hopToLowPlayers(Logs, Amount, MinPlayers, MaxPlayers)
    Amount = Amount or math.huge
    local JobIDs = {}
    local API, ServerPages

    local function FetchJobIDs()
        JobIDs = { os.date("*t").hour }
        local _s = tick()
        if Logs then print("🔍 Scraping servers...") end
        repeat
            task.wait(2)
            local ok, result = pcall(function()
                API = HttpService:JSONDecode(game:HttpGet(
                    "https://games.roblox.com/v1/games/" .. game.PlaceId ..
                    "/servers/Public?sortOrder=Asc&limit=100" ..
                    (ServerPages and "&cursor=" .. ServerPages or "")
                ))
            end)
            if not ok then task.wait(10) return false end
            for _, v in next, API["data"] do
                if v["id"] ~= game.JobId
                and v["playing"] ~= v["maxPlayers"]
                and v["playing"] >= MinPlayers
                and v["playing"] <= MaxPlayers then
                    if #JobIDs < Amount + 1 then
                        table.insert(JobIDs, v["id"])
                    end
                end
            end
            ServerPages = API.nextPageCursor
        until not ServerPages or #JobIDs >= Amount + 1
        if Logs then print("✅ Found " .. (#JobIDs-1) .. " servers in " .. math.round(tick()-_s) .. "s") end
        return true
    end

    if not isfile("ServerHopper//" .. game.PlaceId .. "//low_players-jobids.json") then
        FetchJobIDs()
        CreateFiles("low_players-jobids", HttpService:JSONEncode(JobIDs))
    end

    JobIDs = HttpService:JSONDecode(readfile("ServerHopper//" .. game.PlaceId .. "//low_players-jobids.json"))

    if JobIDs[1] ~= os.date("*t").hour then
        FetchJobIDs()
        writefile("ServerHopper//" .. game.PlaceId .. "//low_players-jobids.json", HttpService:JSONEncode(JobIDs))
    end

    local SelectedJobID = JobIDs[math.random(1, #JobIDs)]
    if Logs then print("🎯 Hopping to: " .. SelectedJobID) end
    TeleportService:TeleportToPlaceInstance(game.PlaceId, SelectedJobID)
    Player.OnTeleport:Connect(function(Status)
        if Status == Enum.TeleportState.Failed then
            TeleportService:TeleportToPlaceInstance(game.PlaceId, JobIDs[math.random(1, #JobIDs)])
        end
    end)
end

local function checkRoundTimeout()
    if not HOP_ENABLED then return end
    if tick() - lastRoundStartTime >= ROUND_TIMEOUT and not isRoundActive then
        print("🚨 No round for " .. math.floor(ROUND_TIMEOUT/60) .. " min, hopping...")
        StatusLabel.Text = "⚡ Status: Server hop..."
        StatusLabel.TextColor3 = Color3.fromRGB(255,100,50)
        hopToLowPlayers(true, HOP_SCRAPE_AMOUNT, HOP_MIN_PLAYERS, HOP_MAX_PLAYERS)
    end
end

task.spawn(function()
    task.wait(30)
    while true do
