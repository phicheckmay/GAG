if AUTOKICK_ENABLED then
    task.spawn(function()
        task.wait(30)
        print("[AutoKick] daily target = " .. DAILY_KICK_TARGET
              .. " | box tinh theo TONG tich luy (khong reset moi session)")

        local alreadyKicked = false
        local lastBoxCount  = nil   -- so box session lan check truoc
        local clockStart    = nil   -- moc bat dau dem 10 phut
        local staleSince    = nil   -- moc phat hien counter thuoc cua so cu
        local weeklyCapSince = nil  -- moc phat hien weekly cham tran (TH1)

        while not alreadyKicked do
            pcall(function()
                -- TONG box da mo cua ca event (cong don qua nhieu ngay),
                -- KHONG phai so box mo trong session nay
                local boxTotal = getSummerCratesOpened() or 0
                local currentLevel   = getPlayerLevel() or 0
                local weekly         = getWeeklyProgress() or 0
                local _, _, dqRaw, _, lastReset = getSummerDailyQuestsProgress()

                local boxTarget, tierMax = getBoxTargetByWeekly(weekly)

                -- TH1: WEEKLY CHAM TRAN -> dem X phut roi kick, VO DIEU KIEN
                -- (bat ke daily/level/box). Weekly 26 = 3 moc x120 shell lanh het,
                -- acc tot nghiep event. X phut dem phang tu luc phat hien, du cho
                -- auto-opener nuong not shell le >= 120 truoc khi roi acc.
                if AUTOKICK_WEEKLY_CAP > 0 and weekly >= AUTOKICK_WEEKLY_CAP then
                    if weeklyCapSince == nil then
                        weeklyCapSince = tick()
                        print(string.format("[AutoKick] TH1: Weekly %d >= tran %d -> kick sau %dp, bat ke dieu kien khac",
                            weekly, AUTOKICK_WEEKLY_CAP, AUTOKICK_WEEKLY_CAP_STALL))
                    end
                    local waitLeft = AUTOKICK_WEEKLY_CAP_STALL * 60 - (tick() - weeklyCapSince)
                    if waitLeft <= 0 then
                        alreadyKicked = true
                        doChangeAccAndKick(string.format("WeeklyMax %d | box +%d | daily %d",
                            weekly, boxTotal, dqRaw))
                    else
                        StatusLabel.Text = "⚡ Status: Weekly max " .. weekly .. " - kick sau " .. math.ceil(waitLeft) .. "s"
                        StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
                    end
                    return
                else
                    weeklyCapSince = nil
                end

                -- TH2 (weekly chua tran): farm binh thuong theo cac check duoi day.
                -- Reset moi 24h luc 08:00 UTC (15:00 VN) - xac nhan tu diagnostic.
                -- Daily con "hom nay" neu chua qua 24h ke tu LastReset.
                -- (Truoc la < 20h -> cat oan 4h cuoi chu ky, daily xong ma khong kick.)
                local diffHours    = (os.time() - lastReset) / 3600
                local dailyIsToday = diffHours < 24
                local dailyFull    = dqRaw >= DAILY_KICK_TARGET and dailyIsToday
                -- DAILY_DONE do task rieng cap nhat (khong phu thuoc AutoKick bat/tat)

                -- CUA SO CU: acc online lien tuc xuyen moc reset -> server chi ap reset
                -- khi JOIN lai, nen LastReset ket qua 24h va counter la cua ngay hom qua.
                -- Farm tiep la vo ich (so khong len nua) -> rejoin de lam moi profile.
                local staleWindow = lastReset > 0 and not dailyIsToday
                if not staleWindow then staleSince = nil end

                local levelOk = AUTOKICK_MIN_LEVEL <= 0 or currentLevel >= AUTOKICK_MIN_LEVEL
                local boxOk   = boxTotal >= boxTarget

                -- Dong ho chi chay sau khi daily du, reset moi lan mo them box
                if not dailyFull then
                    clockStart   = nil
                    lastBoxCount = boxTotal
                else
                    if clockStart == nil then clockStart = tick() end
                    if lastBoxCount ~= boxTotal then
                        lastBoxCount = boxTotal
                        clockStart   = tick()
                    end
                end
                local stallMin = clockStart and ((tick() - clockStart) / 60) or 0

                print(string.format("[AutoKick] daily=%s/%s (reset %.1fh, today=%s) | week=%s (tier<=%s) | box=+%s/%s | lv=%s/%s | stall=%.1fm",
                    tostring(dqRaw), tostring(DAILY_KICK_TARGET), (os.time() - lastReset)/3600, tostring(dailyIsToday),
                    tostring(weekly), tostring(tierMax),
                    tostring(boxTotal), tostring(boxTarget),
                    tostring(currentLevel), tostring(AUTOKICK_MIN_LEVEL),
                    stallMin
                ))

                if not dailyFull then
                    if staleWindow then
                        if staleSince == nil then staleSince = tick() end
                        local waitLeft = math.max(0, 180 - math.floor(tick() - staleSince))
                        StatusLabel.Text = "⚡ Status: Daily cửa sổ cũ - rejoin sau " .. waitLeft .. "s"
                        StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
                        if waitLeft <= 0 then
                            print(string.format(
                                "[AutoKick] Counter cua so cu (reset %.1fh truoc, daily=%d) -> rejoin lam moi profile",
                                diffHours, dqRaw))
                            staleSince = tick()  -- teleport fail thi 3 phut sau tu thu lai
                            pcall(function()
                                game:GetService("TeleportService"):Teleport(game.PlaceId)
                            end)
                        end
                    else
                        StatusLabel.Text = "⚡ Status: Farm daily " .. dqRaw .. "/" .. DAILY_KICK_TARGET
                        StatusLabel.TextColor3 = SummerOrange
                    end

                elseif not levelOk then
                    StatusLabel.Text = "⚡ Status: Chờ level " .. AUTOKICK_MIN_LEVEL .. " (lv" .. currentLevel .. ")"
                    StatusLabel.TextColor3 = Color3.fromRGB(255,200,100)

                else
                    -- Daily xong + du level. Auto-opener (task rieng) la thang tieu shell
                    -- duy nhat -> o day chi QUAN SAT: du box theo tier -> kick, hoac ket
                    -- STALL_MINUTES khong mo them box (shell=0) -> kick.
                    local shells = getSummerCoins() or 0

                    if boxOk then
                        -- Du box theo moc weekly -> kick
                        alreadyKicked = true
                        doChangeAccAndKick(string.format("Daily %d | week %d | box +%d/%d lv%d",
                            dqRaw, weekly, boxTotal, boxTarget, currentLevel))

                    elseif stallMin >= STALL_MINUTES then
                        -- Qua X phut khong mo them duoc box nao (shell = 0 roi vao day) -> kick
                        print(string.format("[AutoKick] %d phut khong mo them box (shell=%d) -> kick, box +%d/%d week %d",
                            math.floor(stallMin), shells, boxTotal, boxTarget, weekly))
                        StatusLabel.Text = "⚡ Status: Không mở thêm được box, chuyển acc..."
                        StatusLabel.TextColor3 = Color3.fromRGB(255,200,100)
                        alreadyKicked = true
                        doChangeAccAndKick(string.format("Timeout | box +%d/%d week %d shell %d",
                            boxTotal, boxTarget, weekly, shells))

                    else
                        StatusLabel.Text = string.format("⚡ Status: Chờ box %d/%d (week %d, shell %d, %dp)",
                            boxTotal, boxTarget, weekly, shells, math.floor(stallMin))
                        StatusLabel.TextColor3 = Color3.fromRGB(200,200,200)
                    end
                end
            end)
            if not alreadyKicked then task.wait(10) end
        end
    end)
end

