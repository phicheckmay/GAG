-- ========================================================================
-- V2.4.1: COIN REGISTRY - hook CoinContainer, giu san danh sach vi tri coin.
-- Coin tren map la vat the TINH (spawn xong dung im) nen cache vi tri an toan.
-- Loi: (1) coin moi spawn giua round vao registry TUC THI qua ChildAdded,
--      (2) bo han 2 vong quet (workspace + GetChildren + doc Position) moi chu ky,
--      (3) doi map round moi -> container cu chet -> tu re-hook, khong can lam gi.
-- ========================================================================

local coinPos      = {}   -- [coin instance] = Vector3
local coinConns    = {}
local curContainer = nil

local function coinPosition(coin)
    if coin:IsA("BasePart") then return coin.Position end
    if coin:IsA("Model") then
        local pp = coin.PrimaryPart or coin:FindFirstChildWhichIsA("BasePart")
        if pp then return pp.Position end
    end
    return nil
end

local function unhookContainer()
    for _, c in ipairs(coinConns) do pcall(function() c:Disconnect() end) end
    coinConns    = {}
    coinPos      = {}
    curContainer = nil
    mapCoinCount = 0
end

local function hookContainer(container)
    unhookContainer()
    curContainer = container
    for _, coin in ipairs(container:GetChildren()) do
        local p = coinPosition(coin)
        if p then coinPos[coin] = p end
    end
    table.insert(coinConns, container.ChildAdded:Connect(function(coin)
        task.defer(function()
            local p = coinPosition(coin)
            if not p then task.wait(0.2); p = coinPosition(coin) end  -- Model cho PrimaryPart stream
            if p and coinPos[coin] == nil then
                coinPos[coin] = p
                mapCoinCount = mapCoinCount + 1
            end
        end)
    end))
    table.insert(coinConns, container.ChildRemoved:Connect(function(coin)
        if coinPos[coin] ~= nil then mapCoinCount = mapCoinCount - 1 end
        coinPos[coin] = nil
    end))
    local n = 0
    for _ in pairs(coinPos) do n = n + 1 end
    mapCoinCount = n
    print("[Farm] Hook CoinContainer: " .. n .. " coin san co")
end

-- Container hien tai con song thi dung luon; chet (doi map) thi quet lai + re-hook
local function getCoinContainer()
    if curContainer and curContainer.Parent then return curContainer end
    local c = returncoincontainer()
    if c then hookContainer(c) end
    return c
end

-- Coin gan nhat doc tu registry (khong quet GetChildren nua)
local function getNearestCoin(container)
    if not BadanPart then return nil end
    local myPos = BadanPart.Position
    local nearest, minDist = nil, math.huge
    for coin, pos in pairs(coinPos) do
        if coin.Parent == container
        and coin:FindFirstChild("TouchInterest")
        and not (skipUntil[coin] and skipUntil[coin] > tick()) then
            local dist = (myPos - pos).Magnitude
            if dist < minDist then
                nearest = coin
                minDist = dist
            end
        end
    end
    return nearest
end

local function getCoinCFrame(coin)
    if coin:IsA("BasePart") then return coin.CFrame end
    if coin:IsA("Model") and coin.PrimaryPart then return coin.PrimaryPart.CFrame end
    return nil
end

