-- 4. MODULE: INVENTORY  (viet lai hoan toan)
-- ------------------------------------------------------------------------
-- V1 gia dinh cung: pd.Weapons.Owned[id] ton tai = so huu, count = 1.
-- Thuc te: duong dan co the khac tuy ban game, va value la SO LUONG.
-- Module nay tu do duong dan roi doi chieu voi Database de xac nhan.
-- ========================================================================

local Inv = {}
do
    local function norm(s)
        return tostring(s):lower():gsub("[%s_%-]", "")
    end
    Inv.norm = norm

    local function tryRequire(parent, name)
        if not parent then return nil end
        local inst = parent:FindFirstChild(name)
        if not inst then return nil end
        local ok, mod = pcall(require, inst)
        return (ok and type(mod) == "table") and mod or nil
    end

    -- Bang dinh nghia item cua game: { [itemId] = {ItemName, Rarity, ItemType} }
    local dbCache
    function Inv.GetDatabase()
        if dbCache then return dbCache end
        local DB = RS:FindFirstChild("Database")
        local Sync = tryRequire(DB, "Sync")
        if Sync and type(Sync.Weapons) == "table" then
            dbCache = Sync.Weapons
            return dbCache
        end
        -- fallback cho ban game de rieng
        local W = tryRequire(DB, "Weapons")
        if W then dbCache = W return dbCache end
        return nil
    end

    function Inv.GetProfile()
        return tryRequire(RS:FindFirstChild("Modules"), "ProfileData")
    end

    -- ✅ DA XAC NHAN bang scan thuc te (Server Version 1450):
    --      ProfileData.Weapons.Owned  -> khop Database 100%
    --      value la NUMBER = so luong  (VD Owned.Icecream = 1)
    --      DB item: RS.Database.Sync.Weapons (997 item)
    --      field:   ItemName / ItemType / Rarity / ItemID / Season / Image
    --    Cac duong dan con lai giu lam du phong khi game update.
    local KNOWN_PATHS = {
        { "Weapons", "Owned" },
        { "Inventory", "Weapons" },
        { "Inventory", "Owned" },
        { "Owned" },
        { "Weapons" },
    }

    local function pick(root, path)
        local node = root
        for _, k in ipairs(path) do
            if type(node) ~= "table" then return nil end
            node = node[k]
        end
        return (type(node) == "table" and next(node) ~= nil) and node or nil
    end

    -- Bang nay co PHAI la bang so huu khong? -> doi chieu key voi Database.
    local function looksLikeOwned(t, db)
        if type(t) ~= "table" then return false end
        if not db then return next(t) ~= nil end
        local hit, total = 0, 0
        for k in pairs(t) do
            if type(k) == "string" then
                total = total + 1
                if db[k] ~= nil then hit = hit + 1 end
            end
            if total >= 30 then break end
        end
        return total > 0 and hit >= math.max(1, math.floor(total * 0.4))
    end

    -- Tra ve { [itemId] = soLuong }
    function Inv.GetOwned()
        local pd = Inv.GetProfile()
        if type(pd) ~= "table" then return {} end
        local db = Inv.GetDatabase()

        local raw
        for _, p in ipairs(KNOWN_PATHS) do
            local t = pick(pd, p)
            if looksLikeOwned(t, db) then
                raw = t
                break
            end
        end
        if not raw then return {} end

        local owned = {}
        for k, v in pairs(raw) do
            if type(k) == "string" then
                local n = 0
                if type(v) == "number" then
                    n = v
                elseif v == true then
                    n = 1
                elseif type(v) == "table" then
                    n = tonumber(v.Count or v.Amount or v.Quantity or v.Qty) or 1
                end
                if n > 0 then owned[k] = n end
            end
        end
        return owned
    end

    -- Doi ten nguoi go -> itemId that (khong phan biet hoa thuong/space/gach)
    -- ⚠️ DB co NHIEU id dung chung 1 ItemName:
    --      Icecream       -> ItemName "Icecream"
    --      IcecreamChroma -> ItemName "Icecream"  (!!)
    --    Neu map ten de len id thi "Icecream" co the tro nham sang Chroma
    --    tuy thu tu pairs(). -> Quet 2 luot: ID truoc (uu tien tuyet doi),
    --    ten sau va CHI dien vao cho con trong.
    local resolveCache, dupName
    local function buildCaches()
        resolveCache, dupName = {}, {}
        local db = Inv.GetDatabase()
        if not db then return end

        -- Luot 1: itemId (chinh xac nhat)
        for id in pairs(db) do
            if type(id) == "string" then resolveCache[norm(id)] = id end
        end

        -- Dem ten trung de biet co can hien them [id] khong
        local nameCount = {}
        for id, def in pairs(db) do
            if type(id) == "string" and type(def) == "table" then
                local dn = def.ItemName or def.Name
                if type(dn) == "string" then
                    local k = norm(dn)
                    nameCount[k] = (nameCount[k] or 0) + 1
                end
            end
        end

        -- Luot 2: ItemName, khong ghi de id da co
        for id, def in pairs(db) do
            if type(id) == "string" and type(def) == "table" then
                local dn = def.ItemName or def.Name
                if type(dn) == "string" then
                    local k = norm(dn)
                    if resolveCache[k] == nil then resolveCache[k] = id end
                    if (nameCount[k] or 0) > 1 then dupName[id] = true end
                end
            end
        end
    end

    function Inv.Resolve(name)
        if not resolveCache then buildCaches() end
        return (resolveCache and resolveCache[norm(name)]) or name
    end

    -- Ten hien thi. Neu ten bi trung voi item khac (Icecream vs IcecreamChroma
    -- deu ten "Icecream") thi dung luon itemId cho khoi lan. Con neu itemId
    -- vua dung bang ten thi giu nguyen, khong lap "Icecream [Icecream]".
    function Inv.Label(itemId, itemName)
        if not resolveCache then buildCaches() end
        local nm = itemName or itemId
        if dupName and dupName[itemId] and norm(nm) ~= norm(itemId) then
            return itemId
        end
        return nm
    end

    -- Thong tin hien thi cua 1 item
    function Inv.Info(itemId)
        local db   = Inv.GetDatabase()
        local def  = db and db[itemId]
        local name = (def and (def.ItemName or def.Name)) or itemId
        return {
            id       = itemId,
            name     = name,
            label    = Inv.Label(itemId, name),
            rarity   = (def and def.Rarity) or "Unknown",
            itemType = (def and def.ItemType) or "Knife",
        }
    end

    -- Item bi cam gui (DefaultKnife / DefaultGun ...)
    local excludeSet
    function Inv.IsExcluded(itemId)
        if not excludeSet then
            excludeSet = {}
            for _, raw in ipairs(EXCLUDE_ITEMS) do
                excludeSet[Inv.Resolve(raw)] = true
            end
        end
        return excludeSet[itemId] == true
    end

    -- So luong 1 item trong tui
    function Inv.Count(nameOrId, ownedCache)
        local owned = ownedCache or Inv.GetOwned()
        return owned[Inv.Resolve(nameOrId)] or 0
    end

    -- Danh sach item can gui. Tra ve mang { {id,name,rarity,itemType,count} }
    function Inv.GetItemsToTrade()
        local owned = Inv.GetOwned()
        local items = {}

        -- Co danh sach chi dinh -> uu tien
        if type(TRADE_ITEMS) == "table" and #TRADE_ITEMS > 0 then
            for _, raw in ipairs(TRADE_ITEMS) do
                local id = Inv.Resolve(raw)
                local n  = owned[id] or 0
                if n > 0 and not Inv.IsExcluded(id) then
                    local info = Inv.Info(id)
                    info.count = n
                    table.insert(items, info)
                end
            end
            return items
        end

        -- Khong co danh sach -> loc theo rarity
        local wantAll = norm(TRADE_RARITY) == "all"
        for id, n in pairs(owned) do
            if not Inv.IsExcluded(id) then
                local info = Inv.Info(id)
                if wantAll or norm(info.rarity) == norm(TRADE_RARITY) then
                    info.count = n
                    table.insert(items, info)
                end
            end
        end
        table.sort(items, function(a, b) return a.label < b.label end)
        return items
    end

    -- Tong SO LUONG con lai (khong phai so dong) - value trong Owned la number
    function Inv.CountBag()
        local ok, n = pcall(function()
            local total = 0
            for _, it in ipairs(Inv.GetItemsToTrade()) do
                total = total + (it.count or 1)
            end
            return total
        end)
        return ok and n or 0
    end

    -- Trai phang theo so luong: {id x3} -> 3 phan tu. Dung de chia lo.
    function Inv.FlattenQueue()
        local flat = {}
        for _, it in ipairs(Inv.GetItemsToTrade()) do
            for _ = 1, (it.count or 1) do table.insert(flat, it) end
        end
        return flat
    end

    -- Danh sach item theo doi, MOI CAI 1 DONG rieng tren UI
    function Inv.WatchList()
        local owned = Inv.GetOwned()
        local rows  = {}
        for _, raw in ipairs(WATCH_ITEMS) do
            local id   = Inv.Resolve(raw)
            local info = Inv.Info(id)
            table.insert(rows, {
                id    = id,
                label = info.label,
                count = owned[id] or 0,
            })
        end
        return rows
    end

    -- Ban 1 dong (dung cho log console)
    function Inv.WatchText()
        local parts = {}
        for _, r in ipairs(Inv.WatchList()) do
            table.insert(parts, r.label .. ": " .. r.count)
        end
        if #parts == 0 then return "⚔️ (chua set WatchItems)" end
        return "⚔️ " .. table.concat(parts, " | ")
    end

    -- In cau truc ra console khi Debug = true
    function Inv.Dump()
        local pd = Inv.GetProfile()
        print("[Inv] ProfileData =", type(pd))
        if type(pd) == "table" then
            for k, v in pairs(pd) do print("  ." .. tostring(k), type(v)) end
        end
        local db = Inv.GetDatabase()
        print("[Inv] Database.Weapons =", type(db))
        local owned = Inv.GetOwned()
        local c = 0
        for id, n in pairs(owned) do
            local i = Inv.Info(id)
            print(("  [%s] x%s | %s | %s"):format(id, tostring(n), i.name, i.rarity))
            c = c + 1
            if c >= 60 then print("  ... (cat bot)") break end
        end
        print("[Inv] Tong item so huu: " .. c)
    end
end

if DEBUG then pcall(Inv.Dump) end

