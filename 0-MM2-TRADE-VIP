            break
        else
            if attempts >= 5 then
                StatusLabel.Text = "❌ Thất bại sau 5 lần thử!"
                StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 50)
                print("[TradeVip] That bai sau 5 lan thu!")
                break
            end
            print("[TradeVip] That bai, thu lai sau " .. RETRY_DELAY .. "s...")
            StatusLabel.Text = "⏳ Thử lại sau " .. RETRY_DELAY .. "s... (" .. attempts .. "/5)"
            task.wait(RETRY_DELAY)
        end
    end
end)
