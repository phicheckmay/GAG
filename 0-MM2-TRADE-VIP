    -- SENDER: MM2 toi da 4 item/lo -> gui tung lo, re-scan tui, den khi rong.
    setStatus("📤 Bắt đầu gửi item...", Gold)
    local attempts = 0
    while true do
        -- Trai phang theo so luong roi cat lo <= MAX_PER_TRADE
        local queue = Inv.FlattenQueue()

        if #queue == 0 then
            print("[TradeVip] Da gui het item chi dinh!")
            autoKickModule()
            break
        end

        local batch = {}
        for i = 1, math.min(MAX_PER_TRADE, #queue) do
            table.insert(batch, queue[i])
        end

        local names = {}
        for _, it in ipairs(batch) do table.insert(names, it.label or it.name) end
        ItemsLabel.Text = "📦 Còn " .. #queue .. " | lô này: "
                          .. table.concat(names, ", ")
        print("[TradeVip] Con " .. #queue .. " item, gui lo "
              .. #batch .. ": " .. table.concat(names, ", "))

        tradeComplete = false
        setSender("📡 Đang gửi lô (" .. #batch .. "/" .. #queue .. ")...", Purple)

        if doTrade(batch) then
            attempts = 0
            print("[TradeVip] Lo thanh cong, re-scan tui...")
            task.wait(2)
        else
            attempts = attempts + 1
            if attempts >= MAX_ATTEMPTS then
                setStatus("❌ Thất bại sau " .. MAX_ATTEMPTS .. " lần thử!", Red)
                print("[TradeVip] That bai sau " .. MAX_ATTEMPTS .. " lan thu!")
                break
            end
            setStatus("⏳ Thử lại sau " .. RETRY_DELAY .. "s... ("
                      .. attempts .. "/" .. MAX_ATTEMPTS .. ")", Gray)
            task.wait(RETRY_DELAY)
        end
    end
end)
