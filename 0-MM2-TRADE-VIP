-- 7. MODULE: ACCEPT-CLICKER
-- ------------------------------------------------------------------------
-- Ban game nay khong an remote AcceptRequest/AcceptTrade. Thay vao do
-- tim nut Accept dang hien (ke ca ImageButton) roi BAM -> game tu fire.
--   * RECEIVER: chay vong auto-accept LIEN TUC (passive)
--   * SENDER  : CHI bam Accept cua chinh minh trong luc gui trade
-- ========================================================================

local ClickerGui  = Player:WaitForChild("PlayerGui")
local ACCEPT_KEYS = { accept = true, confirm = true, yes = true }

local function ck_clean(s) return tostring(s):lower():gsub("%s+", "") end

local function ck_isTradeButton(btn)
    local node = btn
    while node and node ~= game do
        if node.Name:lower():find("trade") then return true end
        node = node.Parent
    end
    return false
end

local function ck_isShown(gui)
    local node = gui
    while node and node ~= ClickerGui do
        if node:IsA("GuiObject") and node.Visible == false then return false end
        node = node.Parent
    end
    return node == ClickerGui
end

local function ck_labelOf(b)
    if type(b.Text) == "string" and b.Text ~= "" then return b.Text end
    for _, d in ipairs(b:GetDescendants()) do
        if d:IsA("TextLabel") and type(d.Text) == "string" and d.Text ~= "" then
            return d.Text
        end
    end
    return ""
end

local function ck_isAccept(b)
    if ACCEPT_KEYS[ck_clean(b.Name)] then return true end
    if b.Parent and ACCEPT_KEYS[ck_clean(b.Parent.Name)] then return true end
    if ACCEPT_KEYS[ck_clean(ck_labelOf(b))] then return true end
    return false
end

local function ck_fireSignal(signal)
    local fired = false
    pcall(function()
        if getconnections then
            for _, c in ipairs(getconnections(signal)) do
                if typeof(c.Fire) == "function" then c:Fire(); fired = true
                elseif typeof(c.Function) == "function" then c.Function(); fired = true end
            end
        end
    end)
    if not fired then
        pcall(function() if firesignal then firesignal(signal); fired = true end end)
    end
    return fired
end

local function ck_click(btn)
    local a = ck_fireSignal(btn.MouseButton1Click)
    local b = ck_fireSignal(btn.Activated)
    return a or b
end

local function scanClickAccept(lastClick)
    for _, g in ipairs(ClickerGui:GetDescendants()) do
        if g:IsA("GuiButton") and g.Visible and ck_isTradeButton(g)
           and ck_isShown(g) and ck_isAccept(g) then
            local now = tick()
            if not lastClick[g] or now - lastClick[g] > 2.5 then
                lastClick[g] = now
                print("[TradeVip] Bam Accept '" .. g.Name .. "' -> "
                      .. tostring(ck_click(g)))
            end
        end
    end
end

local function getTradePartner()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player then
            for _, g in ipairs(ClickerGui:GetDescendants()) do
                if g:IsA("TextLabel") and g.Visible and type(g.Text) == "string"
                   and g.Text:find(p.Name, 1, true)
                   and ck_isTradeButton(g) and ck_isShown(g) then
                    return p.Name
                end
            end
        end
    end
    return nil
end

-- ========================================================================
-- 8. MODULE: ACC-CHANGER  (doi acc tu farm Decode)
-- ------------------------------------------------------------------------
-- Doi acc THAT SU qua getgenv().client:ChangeToFolder (do tool farm Decode /
-- luarmor cung cap). Config folder o getgenv().ChangeAccConfig.
-- Trung khop 100% voi cach MM2-SUMMER-V2 dang lam.
-- ========================================================================

local AccChanger = {}
do
    local function aclog(...) print("[AccChanger]", ...) end

    function AccChanger.GetFolders(profile)
        profile = profile or "Done Quest"
        local from, to = "", ""
        pcall(function()
            if not getgenv then return end
            local g = getgenv()

            -- ⚠️ FIX: V1 dung { g.ChangeAccConfig, g.TLfig, g.TradeVipConfig }
            -- Neu phan tu dau la nil thi mang bi LO -> ipairs dung ngay
            -- vong 0 -> khong bao gio tim ra folder. Gio push tung cai.
            local cands = {}
            local seen  = {}
            local function push(v)
                if type(v) == "table" and not seen[v] then
                    seen[v] = true
                    table.insert(cands, v)
                end
            end

            push(g.ChangeAccConfig)   -- ten goc cua Decode
            push(g.TLfig)             -- ten trong change-acc.txt

            -- Quet moi global co key ["Change Mode"]
            for _, v in pairs(g) do
                if type(v) == "table" then
                    local ok = false
                    pcall(function() ok = v["Change Mode"] ~= nil end)
                    if ok then push(v) end
                end
            end

            for _, cfg in ipairs(cands) do
                pcall(function()
                    local decode = cfg["Change Mode"] and cfg["Change Mode"]["Decode"]
                    local entry  = decode and decode["Folder"] and decode["Folder"][profile]
                    if entry and ((entry["Folder 1"] or "") ~= ""
                               or (entry["Folder 2"] or "") ~= "") then
                        from = entry["Folder 1"] or ""
                        to   = entry["Folder 2"] or ""
                    end
                end)
                if from ~= "" or to ~= "" then break end
            end
        end)
        return from, to
    end

    function AccChanger.IsAvailable()
        local ok = false
        pcall(function()
            ok = (getgenv and getgenv().client
                  and type(getgenv().client.ChangeToFolder) == "function") and true or false
        end)
        return ok
    end

    function AccChanger.Mark(text)
        pcall(function() writefile(Player.Name .. ".txt", text or "Done Quest") end)
    end

    function AccChanger.MoveFolder(from, to)
        -- Phai co DU CA HAI. Nua voi (VD Folder 2 chua dien) ma van goi thi
        -- acc bi day vao folder rong -> khong lay lai duoc.
        if from == "" or to == "" then
            aclog("Thieu folder (from='" .. from .. "' to='" .. to .. "') -> khong chuyen")
            return false
        end
        if not AccChanger.IsAvailable() then
            aclog("getgenv().client:ChangeToFolder khong co -> Decode chua load?")
            return false
        end
        local ok, err = pcall(function()
            getgenv().client:ChangeToFolder(from, to, false, nil)
        end)
        if ok then aclog(("Chuyen folder: '%s' -> '%s'"):format(from, to))
        else aclog("ChangeToFolder loi: " .. tostring(err)) end
        return ok
    end

    -- opts: From, To, Profile, MarkText, Reason, Delay, Kick, KickIfNoChanger
    function AccChanger.Switch(opts)
        opts = opts or {}

        -- Uu tien folder go thang trong config. Chi khi de trong VA co khai
        -- Profile thi moi di do global cua acc manager khac (VD Decode).
        local from = opts.From or ""
        local to   = opts.To   or ""
        if from == "" and to == "" and opts.Profile then
            from, to = AccChanger.GetFolders(opts.Profile)
            aclog("Lay folder tu global theo profile '" .. opts.Profile .. "'")
        end
        aclog(("from='%s' to='%s'"):format(from, to))

        AccChanger.Mark(opts.MarkText or "Done Trade")
        local moved = AccChanger.MoveFolder(from, to)

        if opts.Kick == false then return moved end
        if not moved and not opts.KickIfNoChanger then
            aclog("Khong chuyen duoc folder -> KHONG kick (tranh lap vo han)")
            return false
        end
        task.wait(opts.Delay or 3)
        pcall(function() Player:Kick(opts.Reason or "Trade VIP - xong") end)
        return true
    end
end

