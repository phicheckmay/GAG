local function autoKickModule()
    local remaining = Inv.CountBag()
    ItemsLabel.Text = "📦 Còn " .. remaining .. " item " .. TRADE_RARITY .. " trong túi"
    print("[AutoKick] Re-scan tui: con " .. remaining .. " item " .. TRADE_RARITY)

    if remaining > 0 then return false end

    if not (AUTOKICK_ON and AFTER_TRADE ~= "idle") then
        setStatus("✅ Đã gửi hết item! (không kick)", Green)
        return true
    end

    print("[AutoKick] Tui het item chi dinh -> doi acc + kick")
    if CHANGEACC_ON then
        setStatus("✅ Hết item - Đổi acc & kick...", Green)
        AccChanger.Switch({
            From            = CHANGEACC.From,
            To              = CHANGEACC.To,
            Profile         = CHANGEACC.Profile,   -- nil = khong do global
            MarkText        = CHANGEACC.MarkText,
            Delay           = CHANGEACC.Delay or 3,
            Reason          = "Trade VIP - da gui het item",
            KickIfNoChanger = CHANGEACC.KickIfNoChanger == true,
        })
    else
        setStatus("✅ Hết item - Đang kick...", Green)
        task.wait(1)
        pcall(function() Player:Kick("Trade VIP - da gui het item") end)
    end
    return true
end

