local function findPlayer(username)
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == username:lower() then return p end
    end
    return nil
end

-- items: lo da chia san (toi da MAX_PER_TRADE phan tu, co the trung id
-- neu so huu nhieu cai giong nhau)
local function doTrade(items)
    if not items or #items == 0 then
        setStatus("❌ Không có item " .. TRADE_RARITY .. " để trade!", Red)
        print("[TradeVip] Khong co item de trade!")
        return false
    end

    itemsTraded = items
    local names = {}
    for _, it in ipairs(items) do table.insert(names, it.label or it.name) end
    ItemsLabel.Text = "📦 " .. table.concat(names, ", ")

    -- Cho receiver vao server (toi da 5 phut)
    setStatus("⏳ Chờ " .. RECEIVER_NAME .. " vào server...", Gray)
    local waitStart, receiver = tick(), nil
    while not receiver and tick() - waitStart < 300 do
        receiver = findPlayer(RECEIVER_NAME)
        if not receiver then task.wait(3) end
    end
    if not receiver then
        setStatus("❌ " .. RECEIVER_NAME .. " không vào server sau 5 phút!", Red)
        return false
    end

    -- Gui trade request
    setStatus("📤 Gửi trade request tới " .. RECEIVER_NAME .. "...", Gold)
    local ok, result = pcall(function() return SendRequest:InvokeServer(receiver) end)
    if not ok or not result then
        print("[TradeVip] SendRequest fail:", tostring(result))
        setStatus("❌ Gửi request thất bại, thử lại...", Red)
        return false
    end
    print("[TradeVip] SendRequest OK:", tostring(result))

    -- Cho ban trade mo. Mot so ban StartTrade chi fire ben receiver ->
    -- lay StartTrade HOAC UpdateTrade lam tin hieu, toi da 6s.
    setStatus("⏳ Chờ " .. RECEIVER_NAME .. " accept request...", Gray)
    local tradeStarted = false
    local c1 = StartTrade.OnClientEvent:Connect(function() tradeStarted = true end)
    local c2 = UpdateTrade.OnClientEvent:Connect(function() tradeStarted = true end)
    local w = tick()
    while not tradeStarted and tick() - w < 6 do task.wait(0.3) end
    c1:Disconnect()
    c2:Disconnect()

    -- Offer 1 LAN (offer lai se reset dong ho chong scam 6s -> ket trade)
    setStatus("📦 Đang offer " .. #items .. " items...", Purple)
    for _, item in ipairs(items) do
        print("[TradeVip] Offering: " .. item.id .. " (" .. item.itemType .. ")")
        pcall(function() OfferItem:FireServer(item.id, item.itemType) end)
        task.wait(0.4)
    end

    -- Tu bam Accept cua chinh minh, cho toi da 40s
    setStatus("⏳ Bấm Accept & chờ hoàn tất...", Green)
    local lastClick = {}
    local t0 = tick()
    while not tradeComplete and tick() - t0 < 40 do
        pcall(function() scanClickAccept(lastClick) end)
        task.wait(0.4)
    end
    return tradeComplete
end

