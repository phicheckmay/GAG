-- Main trade function
local function doTrade()
    -- 1. Scan items
    local items = getItemsToTrade()
    if #items == 0 then
        StatusLabel.Text = "❌ Không có item " .. TRADE_RARITY .. " để trade!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 50)
        print("[TradeVip] Khong co item de trade!")
        return false
    end

    itemsTraded = items
    local itemNames = {}
    for _, item in ipairs(items) do
        table.insert(itemNames, item.name)
    end
    ItemsLabel.Text = "⚔️ Items: " .. table.concat(itemNames, ", ")

    -- 2. Cho receiver vao server
    StatusLabel.Text = "⏳ Chờ " .. RECEIVER_NAME .. " vào server..."
    StatusLabel.TextColor3 = Gray

    local waitStart = tick()
    local receiver = nil
    while not receiver and tick() - waitStart < 300 do  -- cho toi da 5 phut
        receiver = findPlayer(RECEIVER_NAME)
        if not receiver then task.wait(3) end
    end

    if not receiver then
        StatusLabel.Text = "❌ " .. RECEIVER_NAME .. " không vào server sau 5 phút!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 50)
        return false
    end

    -- 3. Send trade request
    StatusLabel.Text = "📤 Gửi trade request tới " .. RECEIVER_NAME .. "..."
    StatusLabel.TextColor3 = Gold

    local ok, result = pcall(function()
        return SendRequest:InvokeServer(receiver)
    end)

    if not ok or not result then
        print("[TradeVip] SendRequest fail:", tostring(result))
        StatusLabel.Text = "❌ Gửi request thất bại, thử lại..."
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 50)
        return false
    end

    print("[TradeVip] SendRequest OK:", tostring(result))
    StatusLabel.Text = "⏳ Chờ " .. RECEIVER_NAME .. " accept request..."
    StatusLabel.TextColor3 = Gray

    -- 4. Cho trade bat dau (StartTrade fire)
    local tradeStarted = false
    local conn = StartTrade.OnClientEvent:Connect(function(tradeData, senderName)
        tradeStarted = true
    end)

    local waitTrade = tick()
    while not tradeStarted and tick() - waitTrade < 30 do
        task.wait(0.5)
    end
    conn:Disconnect()

    if not tradeStarted then
        StatusLabel.Text = "❌ " .. RECEIVER_NAME .. " không accept request!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 50)
        return false
    end

    -- 5. Offer items
    StatusLabel.Text = "📦 Đang offer " .. #items .. " items..."
    StatusLabel.TextColor3 = Purple

    task.wait(1)  -- doi trade UI load

    for _, item in ipairs(items) do
        print("[TradeVip] Offering: " .. item.id .. " (" .. item.itemType .. ")")
        pcall(function()
            OfferItem:FireServer(item.id, item.itemType)
        end)
        task.wait(0.5)
    end

    -- 6. Accept trade
    task.wait(1)
    StatusLabel.Text = "✅ Accept trade..."
    StatusLabel.TextColor3 = Green

    pcall(function()
        AcceptTrade:FireServer(true)
    end)

    -- 7. Cho complete
    local waitComplete = tick()
    while not tradeComplete and tick() - waitComplete < 30 do
        task.wait(0.5)
    end

    return tradeComplete
end

